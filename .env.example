# Groq API key for Rohit's AI Career Assistant (api/chat.js).
# Copy this file to .env.local and paste your key from https://console.groq.com/keys
# On Vercel, add GROQ_API_KEY under Project → Settings → Environment Variables.
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
